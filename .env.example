# Natural Health Pros — environment variables
# Copy to .env.local for development; provision via Vercel env for deploy.

# ----- Postgres (Neon via Vercel Marketplace integration) -----
DATABASE_URL=

# ----- NextAuth v5 -----
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ----- Cloudflare Turnstile (bot check on /auth/signin and /join/<cohort>; OPTIONAL) -----
# Set BOTH to turn the widget on; the server then rejects any submission without a passing token.
# With either missing, Turnstile is skipped (logged once per process) and the forms rely on the
# honeypot, the signed fill-time stamp and rate limits. The site key is passed from the server,
# so it is not a NEXT_PUBLIC_ variable.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ----- Upstash / Vercel KV (rate limiting; optional in Phase 0) -----
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ----- Typesense (Phase 1 search) -----
TYPESENSE_HOST=
TYPESENSE_API_KEY=
NEXT_PUBLIC_TYPESENSE_SEARCH_KEY=

# ----- Email (Resend; Phase 2 notifications) -----
RESEND_API_KEY=

# ----- Vercel Blob (Phase 3 client-held files) -----
BLOB_READ_WRITE_TOKEN=

# ----- Practitioner plans (Plan A / Plan B) -----
# RATES ARE NOT CONFIGURED HERE. Spec v1.5 §2: the database is the only source of rates — every
# price, percentage and term lives in an immutable RateSchedule row a practitioner maps to, edited
# at /admin/commercial-settings. No rate, fee or term is read from the environment
# (tests/no-rate-literals.test.ts enforces it). The only plan settings here are non-rate:
PLAN_A_LABEL=
PLAN_B_LABEL=
# Plan assumed for a practitioner who has not chosen one (PLAN_A or PLAN_B; default PLAN_B; read in src/lib/pricing-plans.ts).
PLAN_DEFAULT=

# ----- Share payouts: referrers and recruiters (spec v1.4 §6.2, v1.5 §5) — OFF, and deliberately so -----
# Summary of the rules and the enabling sequence: docs/money-model.md and docs/runbooks/transfers-canary.md.
# Each share moves to the payee's Whop balance by an internal transfer as the client's payment
# clears (the payment webhook sends it; the hourly whop-reconcile cron is the retry backstop). The
# share is sent in full: Whop's own withdrawal fee is taken from each person's balance when they
# withdraw and appears in no ledger figure.
# 🚧 Nothing is enabled before Whop business verification and the canary. The parent company is not
# business-verified, so Whop refuses every transfer from it
# ("Please verify your business before transferring funds"). Complete verification in the Whop
# dashboard FIRST, then set this to the literal string `true`. Any other value is off.
WHOP_TRANSFERS_ENABLED=
# Canary guard. When set, comma-separated practitioner ids: ONLY those payees are ever transferred
# to (referral and recruiter shares alike); every other row stays waiting. Unset means no
# restriction. A value that names nobody (blank, commas only) pays nobody. Use it for the first
# real transaction, then remove it when going live for everyone. Leave the line commented out (or
# absent) otherwise: a present-but-blank value is an empty list, which pays nobody.
# WHOP_TRANSFERS_ALLOWLIST=prac_abc123,prac_def456
# Two independent records of what canary Step 0 (scripts/whop-canary-transfer.ts) proved. Set each to the
# literal string `true` ONLY from its own result in the report (`recommendedFlags` applies the rule):
#   IDEMPOTENCE_VERIFIED  `repeatCreatedSecondTransfer` is false: a repeated request with the same
#                         idempotence_key did NOT create a second transfer. Then an attempt that ended
#                         with an unknown outcome is re-sent with the same key, whatever the lookup says.
#   LOOKUP_VERIFIED       `lookupFoundFirst` is true: GET /transfers found the known canary transfer by
#                         its metadata. Then a lookup that finds nothing (and reached the end of the
#                         list) counts as "it did not go out" and allows the re-send.
# With neither set, an attempt that ends with an unknown outcome (timeout, 5xx, network error, a success
# status with no transfer id) is never re-sent: the row waits for an admin on /admin/commercial-settings
# to record whether it went out. Leave both commented out or absent until the canary has been read.
# WHOP_TRANSFERS_IDEMPOTENCE_VERIFIED=true
# WHOP_TRANSFERS_LOOKUP_VERIFIED=true

# ----- Client attribution ledger -----
# DEPRECATED — superseded by the lead attribution term in the practitioner's RateSchedule,
# snapshotted per attribution row. Still read only to keep writing the legacy `expiresAt` column
# during expand/contract; nothing branches on it for money.
ATTRIBUTION_CLAIM_WINDOW_DAYS=
# Fallback for the operator-editable unclaimed-share window (`referral_hold_days`, default 90): how
# long a referrer's share waits while they cannot yet receive money. Used only when the database has
# no row for it; the database value wins; see src/lib/platform-settings.ts. (The lead attribution
# term is not a setting; it lives in the rate schedule.)
REFERRAL_HOLD_DAYS=
# Permanent once set — rotating it invalidates every stored hash.
ATTRIBUTION_EMAIL_SALT=
# Example session price used only for the plan-comparison table (cents; display only, not a rate).
PLAN_COMPARISON_SESSION_PRICE_CENTS=
