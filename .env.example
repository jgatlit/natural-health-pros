# HHE Directory — environment variables
# Copy to .env.local for development; provision via Vercel env for deploy.

# ----- Postgres (Neon via Vercel Marketplace integration) -----
DATABASE_URL=

# ----- NextAuth v5 -----
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ----- Upstash / Vercel KV (rate limiting; optional in Phase 0) -----
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ----- Typesense (Phase 1 search) -----
TYPESENSE_HOST=
TYPESENSE_API_KEY=
NEXT_PUBLIC_TYPESENSE_SEARCH_KEY=

# ----- Email (Resend; Phase 2 notifications) -----
RESEND_API_KEY=

# ----- Vercel Blob (Phase 3 client-held files) -----
BLOB_READ_WRITE_TOKEN=

# ----- Practitioner plans (Plan A / Plan B) -----
# Every value is OPEN pending Amy's decision; defaults in src/lib/pricing-plans.ts are placeholders.
# Splits are the PLATFORM's share in basis points (10000 = 100%).
PLAN_A_MONTHLY_FEE_CENTS=
PLAN_A_FIRST_SESSION_FEE_BPS=
PLAN_A_LATER_SESSION_FEE_BPS=
PLAN_B_MONTHLY_FEE_CENTS=
PLAN_B_FIRST_SESSION_FEE_BPS=
PLAN_B_LATER_SESSION_FEE_BPS=

# ----- Referrer payouts (spec v1.4 §6.2) — OFF, and deliberately so -----
# 🚧 The parent company is NOT business-verified, so Whop refuses every transfer from it
# ("Please verify your business before transferring funds"). Complete verification in the Whop
# dashboard FIRST, then set this to the literal string `true`. Any other value is off.
# Turning it on before verification does not break anything — the transfer simply fails and the
# ledger row stays PAYABLE — but the reason will be a Whop error rather than a clear block.
WHOP_TRANSFERS_ENABLED=

# ----- Cross-referral split (spec v1.4 R6/R7) -----
# When practitioner X refers a client to practitioner Y, a session inside the term costs 40% in
# total on EITHER plan: 20% to us and 20% to X. Y's own plan is deliberately NOT consulted on this
# path. Both are the PLATFORM-side share in basis points, and their sum must not exceed 10000.
XREF_NHP_FEE_BPS=
XREF_REFERRER_FEE_BPS=

# ----- Client attribution ledger -----
# DEPRECATED — superseded by the Lead Attribution Term, which is an ADMIN SETTING
# (/admin/commercial-settings), snapshotted per attribution row. Still read only to keep writing
# the legacy `expiresAt` column during expand/contract; nothing branches on it for money.
ATTRIBUTION_CLAIM_WINDOW_DAYS=
# Fallbacks for the two operator-editable commercial settings, used only when the database has no
# row for them. The database value wins; see src/lib/platform-settings.ts.
LEAD_ATTRIBUTION_TERM_MONTHS=
REFERRAL_HOLD_DAYS=
# Permanent once set — rotating it invalidates every stored hash.
ATTRIBUTION_EMAIL_SALT=
# Typical session price used only for the plan-comparison table (cents; default 15000).
PLAN_COMPARISON_SESSION_PRICE_CENTS=
