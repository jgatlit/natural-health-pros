// HHE Directory — Phase 0 schema
// HHE-students-first practitioner directory (post-5/15 clean restart)
// Brand: HHE Directory (supersedes "PracticeNear" name discontinued 2026-05-24)
// See STRATEGIC_RECONCILIATION_2026-05-18 + decisions-JSON Phase 1 YES rows

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon Marketplace integration prefixes all env vars with `hhe_directory_` by default.
  // If the prefix is later removed in Vercel/Neon settings, rename to standard names.
  url       = env("hhe_directory_DATABASE_URL") // pooled (pgbouncer) — runtime queries
  directUrl = env("hhe_directory_DATABASE_URL_UNPOOLED") // unpooled — Prisma Migrate (DDL needs direct connection)
}

// ----- NextAuth v5 tables (Prisma adapter contract) -----

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailVerified   DateTime?
  image           String?
  role            Role      @default(CLIENT)
  /// Session revocation counter. Every issued JWT carries the value it was minted with; the
  /// `jwt` callback invalidates any token whose value no longer matches. Bumping this signs the
  /// user out EVERYWHERE, immediately.
  ///
  /// This exists because sessions no longer expire (auth.config.ts, ~13 months) and the JWT
  /// strategy writes no `Session` rows — so without it there is nothing to delete and a stolen
  /// token would be valid forever. Deleting the user achieves the same end by a different route:
  /// no row, no valid session.
  ///
  /// Note this is NOT how a demotion takes effect. Role is re-read per request, and a demoted
  /// admin should stay signed in as a practitioner rather than be thrown out. Bump this only to
  /// KILL sessions — a suspected token compromise, a lost device, an offboarding.
  sessionVersion  Int       @default(0)
  /// Set once, at first genuine onboarding (submitOnboarding), never overwritten on a later
  /// revisit. Null means "never asked" for anyone who reached this schema before the click-to-
  /// acknowledge step existed (the 12 pilot practitioners onboarded before 2026-08-25) — treat
  /// null as "not yet accepted", not as a bug; there is no retroactive backfill for a
  /// not-yet-final draft (see docs/runbooks or _handoff-context/tc-draft.md for the open gaps).
  termsAcceptedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  practitioner        Practitioner?
  invitationsSent     Invitation[]         @relation("InvitedBy")
  invitationsAccepted Invitation[]         @relation("AcceptedBy")
  emailChangeRequests EmailChangeRequest[]
}

enum Role {
  CLIENT
  PRACTITIONER
  ADMIN
}

// Wedge 2C — Whop Platforms KYC lifecycle (sub-merchant company verification)
enum WhopKycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

// Wedge 2C — WhopProduct interval semantics
enum ProductInterval {
  ONE_TIME
  MONTHLY
  ANNUAL
}

// ── Booking & checkout (canonical spec v2, vault art_c688ea69482744d19c89) ────────────────────
//
// These ARE enums, unlike whopPayoutStatus which is deliberately a String. The distinction is
// ownership: whopPayoutStatus holds values Whop sends us, and an unrecognised value would make
// the write throw inside a webhook handler that Whop retries only 3× over ~70s. Every enum below
// holds values WE derive, so the set cannot surprise us at runtime.

/// Derived from the booking URL's hostname on paste (§6). Never practitioner-supplied.
enum BookingProvider {
  CALENDLY
  CAL_COM
  ACUITY
  SAVVYCAL
  OTHER
}

/// D3 — general-purpose, NOT free-consult-specific. Gates the profile GRID only; the Booking Link
/// chooser lists every Offering pointing at the link REGARDLESS of this value (§4). That is what
/// makes an unlisted free consult reachable there and nowhere else, and it is why one boolean
/// could never express both layers.
enum ListingVisibility {
  LISTED
  LINK_ONLY
}

/// Diagnostic, not a vanity metric — it proxies buyer intent at entry. BOOKING_LINK is a buyer
/// decided to ACT; OFFERING_CARD is one still deciding.
enum BookingEntryPoint {
  BOOKING_LINK
  OFFERING_CARD
}

/// Who earns commission on a booking (§16, §17).
///
/// PRACTITIONER is 0% and NHP is 20% — the rate lives in code (`COMMISSION_RATE`), not here,
/// because a rate change must not be a migration. This enum records WHO, not HOW MUCH.
enum LeadAttributionParty {
  PRACTITIONER
  NHP
}

enum BookingIntentStatus {
  PENDING
  SCHEDULED
  PAID
  ABANDONED
}

/// §8 — how much we trust that scheduling actually happened. Surfaced to the practitioner so an
/// unverified booking is visibly unverified. ASSUMED means the buyer advanced past step 2 with
/// neither a provider event nor a self-report, which is explicitly allowed: no external signal is
/// a state-transition guard (D8).
enum ScheduleSignal {
  EVENT
  SELF_REPORT
  ASSUMED
}

// Layer X — practitioner platform-subscription lifecycle (they pay us to be listed)
enum SubscriptionStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELED
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ----- HHE Directory Phase 0 domain -----

model Practitioner {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  slug        String  @unique
  displayName String
  bio         String? @db.Text

  // V1 pilot — rich landing-page fields (Amy 5/28; LLM-onboarding normalizes these)
  headline               String? // credentials / professional title line under the name
  tagline                String? // short hook above the whoIHelp paragraph; extractive-only (compressed from the practitioner's own words, never an invented claim). Optional — NOT a completeness signal.
  whoIHelp               String?  @db.Text // "who/how I help" block + matching signal (LLM-synthesized when source blank)
  photoUrl               String? // Vercel Blob URL; Avatar falls back to initials when null
  /// NON-DESTRUCTIVE FRAMING for photoUrl — a focal point and a zoom, never a rewritten image.
  ///
  /// Every display frame uses `object-cover`, which crops to the CENTRE by default. Measured
  /// 2026-08-28: 8 of the 13 real photos are exactly square while the hero frame is 4:5, so
  /// centre-cropping silently removes ~20% of the sides of most portraits — heads sit off-centre
  /// far more often than the centre default assumes.
  ///
  /// Stored as data rather than applied to the file on purpose. A destructive crop can be done
  /// once; this is repeatable forever, needs no image pipeline, cannot corrupt the original, and
  /// costs nothing to undo. The defaults below reproduce today's rendering EXACTLY, so every
  /// existing row is already correct and no backfill is required.
  photoFocalX            Float    @default(0.5) // 0 = left edge, 1 = right edge
  photoFocalY            Float    @default(0.5) // 0 = top edge, 1 = bottom edge
  photoZoom              Float    @default(1.0) // 1 = fit (cover), >1 magnifies about the focal point
  websiteUrl             String? // external site (classified out of overloaded col-D)
  telehealth             Boolean? // offers virtual sessions (~70% of pilot)
  inPerson               Boolean? // offers in-person sessions
  /// ⚠️ NO LONGER RENDERED anywhere as of 2026-08-15. Its only surface was the booking rail's
  /// hero sub-line, which §17.4a replaced with the link label + scheduler host. Offerings now
  /// carry their own prices, which is the more precise signal. Left in place rather than dropped
  /// because the landing copy's "Sessions from $29–$219+" claim was specced to be derived from
  /// real data (docs/brand/CLAIMS-REVIEW-JONATHAN-AMY.md §1) and this is the column that would
  /// feed it. Do NOT wire it back into the rail without re-reading §4's CTA hierarchy.
  firstSessionPriceCents Int? // first-session price in cents; render as $X.XX
  hheCertified           Boolean  @default(true) // HHE-certification trust badge (pilots are HHE grads)

  /// Qualifications / certifications / education — one credential per entry, in the
  /// practitioner's own words ("BS in Nutrition, Bastyr University").
  ///
  /// Replaces the redundant right-pane specialties list, which repeated the chips already shown
  /// in the identity rail. Amy originated this ask from her own 08-17 interface review.
  ///
  /// A scalar list rather than a relation, deliberately: these are unordered free-text lines with
  /// no per-row state, nothing links to them, and modelling them as rows would buy an id, a join
  /// and a sort_order that nothing would ever use. Defaults to empty, so the migration is
  /// expand-safe and every existing practitioner reads as "none stated" rather than null.
  qualifications String[]

  cityId      String?
  city        City?                   @relation(fields: [cityId], references: [id])
  specialties PractitionerSpecialty[]
  caseStudies CaseStudy[]

  latitude  Float?
  longitude Float?

  // Denormalized for pg_trgm typo tolerance (Decisions-JSON Phase 1)
  searchText String? @db.Text

  // Range-facetable attribute (Phase 1 stretch)
  yearsInPractice Int?

  // Wedge 2B — practitioner-owned booking links (Cal.com / Calendly / etc.)
  // Multi-tenant by construction: each practitioner brings their own scheduling provider.
  // Multiple links supported (e.g. "Free intro" + "Deep dive"); see BookingLink.
  bookingLinks BookingLink[]
  // DEPRECATED: superseded by bookingLinks. Kept for expand/contract zero-downtime
  // migration on the shared Neon DB; data copied into BookingLink. Drop in a follow-up.
  bookingUrl   String?

  /// §14.3 — designates the hero CTA's link. When a practitioner runs purpose-built links and
  /// designates NONE, the hero CTA is suppressed and Offering cards lead: in that topology the
  /// cards ARE the correct entry point, and a hero pointing at one arbitrary calendar would
  /// misrepresent the practice. `@unique` because Prisma models this side of a 1-1; it also
  /// correctly forbids one link being primary for two practitioners.
  primaryBookingLinkId String?      @unique
  primaryBookingLink   BookingLink? @relation("PrimaryBookingLink", fields: [primaryBookingLinkId], references: [id], onDelete: SetNull)

  /// §11 — per-practitioner global, NOT per-Offering. "Send leads immediately" (default) vs
  /// "send leads upon checkout". Suppresses EMAILS ONLY: the scheduled-but-unpaid dashboard view
  /// is a service obligation with a client waiting, and must never be switchable off by a
  /// lead-email preference.
  notifyLeadsImmediately Boolean @default(true)

  /// 🚨 SECURITY — NOTIFICATION SENDERS ONLY. Additional recipients for lead/booking notices.
  /// This column must NEVER be read by the magic-link or invitation senders: those emails carry
  /// authentication material, so CC-ing an attacker-supplied address is a direct account-takeover
  /// vector. Any new sender that reads this field needs an explicit review of what it transmits.
  notificationCcEmails String[] @default([])

  bookingIntents BookingIntent[]

  /// Plan A / Plan B — the practitioner's chosen commercial arrangement (2026-09-14 Amy call).
  ///
  /// String, not a Prisma enum, for the same reason `whopPayoutStatus` is: a third plan must never
  /// throw inside a webhook handler and poison the retry.
  ///
  /// NULL IS MEANINGFUL AND MUST STAY THE DEFAULT — it means "has not chosen yet", which is true
  /// of every practitioner listed before this shipped. Defaulting them into a plan would enrol
  /// people in a commercial term they never agreed to.
  plan         String?
  planChosenAt DateTime?

  /// Clients Natural Health Pros introduced to this practitioner — see src/lib/attributed-clients.ts.
  attributedClients AttributedClient[]

  /// Referral shares this practitioner is OWED (they made the referral) and shares their own
  /// sessions GENERATED (someone referred the client to them). Two relations to one model, named
  /// because Prisma cannot guess which side is which.
  referralEntriesEarned    ReferralLedgerEntry[] @relation("ReferralEntriesEarned")
  referralEntriesGenerated ReferralLedgerEntry[] @relation("ReferralEntriesGenerated")

  // Wedge 2C — Whop Connected Account (Layer Y: patient → practitioner)
  // whopCompanyId is the practitioner's connected company under WHOP_PARENT_COMPANY_ID.
  // KYC + payouts are handled by Whop's hosted flows; see docs/PHASE-2C-WHOP-CONNECTED-ACCOUNTS.md.
  whopCompanyId         String?       @unique
  /// DEPRECATED — 4-state enum cannot represent Whop's 9 payout statuses. Superseded by
  /// whopPayoutStatus + whopPayoutsEnabled. Retained one release per expand/contract; the
  /// migration applies while the PREVIOUS deploy still serves traffic, so this must not vanish
  /// until nothing reads it. Drop in a follow-up.
  whopKycStatus         WhopKycStatus @default(NOT_STARTED)
  whopKycCompletedAt    DateTime?
  /// Whop's calculated payout status. Deliberately String, NOT a Prisma enum: an unrecognised
  /// value from Whop would make the enum write throw inside a webhook handler, and Whop retries
  /// only 3 times over ~70s before dropping the event permanently.
  whopPayoutStatus      String        @default("not_started")
  /// THE gate for public checkout. WEBHOOK-AUTHORITATIVE, NOT POLLABLE — re-corrected 2026-08-14
  /// after the 08-13 note claimed GET /identity_profiles/{id} made it verifiable. The field is
  /// returned by that endpoint but is NOT reliable there: Whop's own identity_profile.updated for
  /// idpf_f9VEKuIiqGPc2 carried `payouts_enabled: true` with `linked_companies` populated, while
  /// GET /identity_profiles returns `false` with `linked_companies: []` for that same profile.
  /// A parent-company API key under-reports both. Never gate a sweep on the polled boolean —
  /// use `status: 'approved'` + `payout_status: 'connected'`, which do read accurately.
  whopPayoutsEnabled    Boolean       @default(false)
  /// `idpf_…`. Learned from identity_profile.* webhooks (envelope company_id → data.id) — that
  /// pairing is the ONLY way to build the mapping, because linked_companies reads back empty
  /// for parent-company API keys, so the profile list cannot be attributed to a company.
  whopIdentityProfileId String?
  /// `poact_…`. GET /payout_accounts keys on THIS id, not the company id — passing biz_… always
  /// 404s (verified live 2026-08-13 against both connected accounts). Learned from
  /// payout_account.status_updated. Without it, payout status cannot be polled at all.
  whopPayoutAccountId   String?       @unique
  whopCompanyCreatedAt  DateTime?
  whopProducts          WhopProduct[]

  // Layer X — platform subscription (practitioner pays $49/mo to be listed; pilots trial for 90 days)
  subscriptionStatus SubscriptionStatus @default(NONE)
  /// DEPRECATED — superseded by trialEndsAt + the ADMIN exemption (see
  /// docs/superpowers/specs/2026-07-16-pilot-trial-design.md). No longer read by isListed().
  /// Column retained one release so the live deployment does not break the moment the
  /// migration applies (expand/contract); drop it in a follow-up once nothing reads it.
  comped             Boolean            @default(false)
  /// 90-day pilot clock. null = pre-trial (operator-seeded, never onboarded) and still listed;
  /// future = trial running; past = expired. Set ONLY by genuine onboarding — never inferred
  /// from a seed date. Admins are exempt from it entirely.
  trialEndsAt        DateTime?

  /// OPERATOR DIRECTORY CONTROLS (/admin/invites). Two columns, not one, because they answer
  /// different questions and the repo has already been bitten by overloading a single field
  /// with two meanings (see RETIREMENT_SENTINEL in practitioner-indexer.ts).
  ///
  /// `delistedAt` — hidden from DISCOVERY, still a working practice. Drops out of /search, the
  /// home page and Typesense; the direct profile URL keeps resolving and BOOKING KEEPS WORKING.
  /// That is the §17 rule that unlisted ≠ unbookable, so this must never reach bookableWhere().
  /// Reversible: null it and the profile returns.
  delistedAt DateTime?
  /// `archivedAt` — soft DELETE. Chosen over a destructive delete so booking intents (leads and
  /// real payment records) survive; a hard delete cascades them away irreversibly. Drops out of
  /// discovery AND out of booking, and hides the row from the admin list by default. Reversible.
  archivedAt DateTime?

  whopMembershipId            String? @unique // membership on our own $49/mo Whop product
  /// Per-practitioner checkout for the monthly listing plan, minted once and reused. Carries
  /// metadata.practitioner_id so the webhook attributes payment directly instead of matching on
  /// email — which silently fails when someone pays from a different address than their profile.
  whopSubscriptionCheckoutUrl String?

  // Invite-only model (5/15 Amy reframe)
  invitedBy  String?
  invitedAt  DateTime?
  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([latitude, longitude]) // haversine "near me"
}

model BookingLink {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  label          String? // optional title, e.g. "Free 15-min intro"
  url            String
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  /// §4 — the public button text. Defaults to "Book a free consultation" when a zero-price
  /// Offering is attached and "Book now" otherwise; practitioner-overridable. When the free
  /// consult is LINK_ONLY, this button is the ONLY signal it exists.
  ctaLabel String?

  /// Auto-detected from the hostname on paste (§6, §15.1). Drives which adapter embeds the
  /// scheduler. OTHER is the null adapter — a first-class member, not an error branch: it is what
  /// runs for a scheduler nobody anticipated, and the flow must be complete with it installed.
  provider BookingProvider @default(OTHER)

  /// D1 — the relationship is owned by the OFFERING side. This back-relation exists so the
  /// chooser can query it; there is no join table and no bidirectional editing.
  offerings      WhopProduct[]
  bookingIntents BookingIntent[]
  /// §14.3 back-relation for Practitioner.primaryBookingLink.
  primaryFor     Practitioner?   @relation("PrimaryBookingLink")

  @@index([practitionerId])
}

// V1 pilot — evolving dual-label taxonomy (Amy 5/29 "collapse synonyms" requirement).
// Canonical node: faceted + matched on. rawLabel (on PractitionerSpecialty) preserves voice.
enum SpecialtyStatus {
  ACTIVE // curated, live canonical
  PROPOSED // promoted from a pending alias, awaiting parent/curation
  MERGED // collapsed into mergedInto; kept for referential history
}

model Specialty {
  id       String      @id @default(cuid())
  slug     String      @unique
  name     String
  parentId String? // hierarchical taxonomy
  parent   Specialty?  @relation("SpecialtyTree", fields: [parentId], references: [id])
  children Specialty[] @relation("SpecialtyTree")

  status       SpecialtyStatus @default(ACTIVE)
  mergedIntoId String? // when MERGED, points at the surviving canonical
  mergedInto   Specialty?      @relation("SpecialtyMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Specialty[]     @relation("SpecialtyMerge")

  aliases       SpecialtyAlias[]
  practitioners PractitionerSpecialty[]
}

// Bridge between a practitioner's raw phrasing and the system canonical.
// PENDING rows are the /admin/specialties moderation queue. APPROVED rows
// sync to Typesense as multi-way synonyms (the "gut health ⇄ digestive disorders" collapse).
enum AliasSource {
  PRACTITIONER // self-entered during intake
  CURATED // operator-authored
  IMPORT // seeded by the onboarding LLM pipeline
}

enum AliasStatus {
  PENDING
  APPROVED
  REJECTED
}

model SpecialtyAlias {
  id          String      @id @default(cuid())
  label       String      @unique // normalized (lowercased, trimmed) raw phrasing
  specialtyId String
  specialty   Specialty   @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  source      AliasSource @default(PRACTITIONER)
  status      AliasStatus @default(PENDING)
  confidence  Float? // 0..1 from LLM/vector mapping; null for curated
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([specialtyId])
}

model PractitionerSpecialty {
  practitionerId String
  specialtyId    String
  rawLabel       String? // the practitioner's exact phrasing (their voice), shown on profile
  /// Practitioner-controlled display order. Before this existed there was no ordering column AND
  /// no query ordered these at all, so Postgres returned join rows in unspecified order — the
  /// "random order" Sarah Schindler reported 2026-08-12. Every read orders by it; ties break on
  /// specialty name so the result is deterministic even when nobody has sorted anything.
  sortOrder      Int          @default(0)
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  specialty      Specialty    @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([practitionerId, specialtyId])
}

// V1 pilot — anonymized outcomes the AI matcher reads (Amy: "if it's not on the
// landing page, it's not going to come up in search"). Backend matching signal +
// optional landing-page block.
model CaseStudy {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  title          String
  summary        String       @db.Text
  outcome        String?      @db.Text
  anonymized     Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([practitionerId])
}

// Wedge 2C — Whop product (offering) attached to a practitioner's sub-merchant company
model WhopProduct {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  whopProductId        String? @unique // products.create response (null until Layer Y wires Whop)
  whopPlanId           String? // plans.create response
  whopCheckoutConfigId String? // checkoutConfigurations.create response
  purchaseUrl          String? // Whop-hosted checkout URL

  title               String
  description         String?
  priceUsdCents       Int // always in cents; render as $X.XX
  applicationFeeCents Int             @default(0) // HHE platform fee per transaction
  interval            ProductInterval @default(ONE_TIME)
  category            String? // offering type label: consultation, product, package, subscription…

  /// DEAD — written by nothing in src/ or scripts/, exposed by no UI, and as of 2026-08-14 read
  /// by nothing either. Retained per expand/contract; drop in a follow-up once the migration can
  /// land safely. Do NOT start writing these: `active` reads like a hidden/visible toggle and is
  /// not one, and the query it used to gate was the public profile's, so setting it false would
  /// remove an Offering from every public surface with nothing explaining why. Visibility is
  /// specced as `listingVisibility` in §17.2b, which gates the grid while `bookingLinkId` gates
  /// the chooser — deliberately two layers, because §4 needs the chooser to list Offerings the
  /// grid hides.
  active    Boolean  @default(true)
  archived  Boolean  @default(false)
  /// Practitioner-controlled display order. Ties break on price ascending, which is the default
  /// a practitioner who never sorts anything gets — Sarah Schindler's explicit fallback ask
  /// ("or at least have it by price from lowest to highest", 2026-08-12).
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Booking & checkout (spec §2, §3, §9; decisions D1, D2, D3, D7) ──

  /// D2 — a free consultation is an OFFERING (price 0, no Whop plan), not "a Booking Link with
  /// zero Offerings". Modelling it the other way cannot express "three paid services PLUS a free
  /// consult" at all, and overloads "unconfigured" to mean "free". Forces acceptsPayments off.
  isConsult Boolean @default(false)

  /// D7 — ONE STORED BIT OF INTENT. Capability is derived, never stored:
  ///   payments_live = acceptsPayments && practitioner.whopPayoutsEnabled && whopPlanId != null
  /// Deliberately NOT a PaymentMode enum and NOT a `whop_status` column — a small enum shadowing
  /// a fact already stored more precisely is the mistake whopKycStatus already made. The gate is
  /// whopPayoutsEnabled (verified 2026-08-14: Whop's payout_status has NINE states, and
  /// payouts_enabled is webhook-authoritative and under-reported on read).
  /// False is a deliberate off-platform sale; true with payouts not enabled is "not ready yet".
  /// §9's pending-verification behaviour falls out for free: tick it early, capability flips
  /// itself on when Whop says so.
  acceptsPayments Boolean @default(false)

  /// Minutes. Display only — we never reason about the practitioner's calendar.
  duration Int?

  /// D1 — the single FK that owns the relationship. SetNull, never Cascade: deleting a Booking
  /// Link must unlink its Offerings, never delete them. Nullable is a real state (§2 derived
  /// table): no link + payments live = async delivery, capture → checkout, no calendar step.
  bookingLinkId String?
  bookingLink   BookingLink? @relation(fields: [bookingLinkId], references: [id], onDelete: SetNull)

  /// D3 — gates the profile GRID only. LINK_ONLY requires bookingLinkId (enforced by
  /// construction in admin, with a DB CHECK as backstop for API/import writes) because an
  /// unlisted Offering with no link would be reachable from nowhere at all.
  listingVisibility ListingVisibility @default(LISTED)

  bookingIntents BookingIntent[]

  @@index([practitionerId, active])
  @@index([bookingLinkId])
}

/// §5 — our record of one buyer moving through capture → schedule → checkout.
///
/// Deliberately NOT a booking record (§18 open): the practitioner's calendar remains the source
/// of truth for the appointment itself. This exists so a lead survives every downstream failure —
/// step 1 is captured before anything external is touched, so a dead scheduler link or a failed
/// checkout still leaves the practitioner a real contact.
model BookingIntent {
  id String @id @default(cuid())

  /// THE PUBLIC ADDRESS OF THIS INTENT — what appears in `/practitioners/[slug]/book/[token]`.
  ///
  /// The flow route is public and unauthenticated, so whatever is in that URL IS the credential.
  /// That is deliberate and load-bearing (§5: it makes returning idempotent, which the T3 new-tab
  /// fallback and §10's resume link both depend on). What was NOT acceptable was using `id` for
  /// it: a cuid is `c` + a base36 MILLISECOND TIMESTAMP + a monotonic counter + a per-process host
  /// fingerprint + a small random block, so ids minted in a known window are enumerable at far
  /// better than random odds. A hit renders the buyer's first name, the offering they chose, and
  /// the practitioner's scheduler URL — on a health-adjacent directory.
  ///
  /// §10's resume email is what forced this: it puts these URLs into inboxes, where they are
  /// forwarded, archived and machine-scanned. Enumeration also has no throttle, because
  /// `rateLimit()` no-ops whenever KV is unprovisioned — which it is on production.
  ///
  /// Generated by POSTGRES, not by the application: the column has a DB-level default so that
  /// during a deploy — when this migration has applied but the PREVIOUS build is still serving
  /// traffic and inserting rows that know nothing about this column — capture keeps working
  /// instead of failing NOT NULL on every submission.
  publicToken String @unique @default(dbgenerated("(replace((gen_random_uuid())::text, '-'::text, ''::text) || replace((gen_random_uuid())::text, '-'::text, ''::text))"))

  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  /// Both nullable and both SetNull: a lead must outlive the link or Offering it came through.
  /// A PAID intent whose Offering was later deleted is still a real transaction we must not lose.
  bookingLinkId String?
  bookingLink   BookingLink? @relation(fields: [bookingLinkId], references: [id], onDelete: SetNull)
  offeringId    String?
  offering      WhopProduct? @relation(fields: [offeringId], references: [id], onDelete: SetNull)

  entryPoint BookingEntryPoint

  // Step 1 (§5) is LEAD CAPTURE, NOT INTAKE. TWO fields as of the single-view design (D12) — the
  // practitioner's own scheduler already asks its intake questions and we neither can nor should
  // duplicate them (§6: no per-practitioner intake-field mapper). `phone` and `note` are retained
  // and still populated by older/imported rows; the live form no longer collects them.
  name  String
  email String
  phone String?
  note  String?

  /// ATTRIBUTION, SNAPSHOTTED AT ROW CREATION (§16, D14).
  ///
  /// The snapshot is the entire point: the cookie it comes from expires, and without a copy taken
  /// here a completed booking's attribution would silently change — or vanish — when it did. This
  /// is what commission is calculated from, so it must be immutable once written.
  ///
  /// ALL NULLABLE, deliberately. Migrations auto-apply during the build while the PREVIOUS deploy
  /// is still serving traffic and still inserting rows that know nothing about these columns, so
  /// a NOT NULL here would fail every capture mid-deploy. Null also honestly means "we never
  /// resolved one" — every row created before this shipped.
  attributionParty  LeadAttributionParty?
  /// The diagnostic that EXPLAINS the party (REF_PARAM, ORGANIC_SEARCH, …). Never a second source
  /// of truth for who is paid — that is `attributionParty` alone.
  attributionSource String?
  /// Full first-touch context: referrer host, campaign params, landing path, first-touch ms epoch.
  attribution       Json?

  /// `ch_…` — the Whop checkout CONFIGURATION minted for THIS booking, and what the embed mounts.
  ///
  /// Name kept from when this held a `chs_…` session, to avoid a rename migration on a live table;
  /// the contents changed when sessions turned out to render Whop's 404 page. See
  /// `createBookingCheckoutConfig` for the evidence.
  ///
  /// Stored so it is minted once rather than on every render of a public page. Configurations do
  /// NOT expire, so this stays valid however late §10's resume email brings the buyer back.
  whopCheckoutSessionId        String?
  /// That configuration's OWN `purchase_url` — the §8 fallback when the embed cannot mount.
  ///
  /// Per-intent, so unlike the offering-level `purchaseUrl` it carries `booking_intent_id` and a
  /// payment taken through it still reconciles. The offering-level one carries only
  /// practitioner_id + offering_id, which is why a payment through it could complete and be
  /// recorded against no booking.
  whopCheckoutPurchaseUrl      String?
  /// DEPRECATED — sessions expired, configurations do not. Nothing reads this; dropped a release
  /// after the currently-deployed code stops referencing it (expand/contract).
  whopCheckoutSessionExpiresAt DateTime?
  /// Set by the `payment.succeeded` webhook, which is the AUTHORITY for payment — never by a
  /// client callback. Its presence is what makes marking PAID idempotent.
  paidAt                       DateTime?

  status         BookingIntentStatus @default(PENDING)
  /// Null until step 2 is passed. See ScheduleSignal — ASSUMED is a valid, expected outcome.
  scheduleSignal ScheduleSignal?
  scheduledAt    DateTime?

  /// §10's resume email — set when NO RESUME EMAIL IS OWED, which covers two cases: one was
  /// sent, or the intent can never be owed one (free consult, archived offering, payments never
  /// live). Recording the second case is what stops permanently-unsendable rows accumulating at
  /// the head of the sweep's `createdAt asc` ordering and starving everything behind the cap.
  ///
  /// Resend's `idempotencyKey` de-duplicates for 24 HOURS, and that is all. Nothing else ever
  /// removes an unpaid intent from the sweep's candidate set — the cold sweep deliberately never
  /// touches SCHEDULED, and `paidAt` stays null forever if the buyer simply decided not to buy —
  /// so a 24h window alone means "one email per day, indefinitely", not "one email". A buyer who
  /// changed their mind would be chased daily for the life of the row, on a sending domain whose
  /// deliverability was hard-won.
  ///
  /// It also fixes a starvation bug: with a `take` cap and no sent-marker, the oldest N eligible
  /// intents are re-selected on every run and intent N+1 is never reached at all.
  resumeEmailSentAt     DateTime?
  /// Same contract for the practitioner's "someone booked a time" notice.
  scheduledNoticeSentAt DateTime?
  /// Same contract again, for the payment confirmation sent to BOTH sides once `paidAt` is set.
  ///
  /// Payment notices are sent from the sweep rather than the webhook on purpose: Whop retries a
  /// webhook 3x over ~70s and then drops it permanently, so the handler must acknowledge fast and
  /// never block on an email. src/lib/email.ts says this in as many words.
  paidNoticeSentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Referrer shares generated by this booking's payment. Plural because a future multi-referrer
  /// rule must not need a migration; the unique constraint on the other side keeps it to one per
  /// referrer today.
  referralEntries ReferralLedgerEntry[]

  @@index([practitionerId, status])
  /// §10's abandonment sweep scans by status + age; without this it degrades to a full scan as
  /// intents accumulate.
  @@index([status, createdAt])
  /// The capture route's per-practitioner burst bound counts on (practitionerId, createdAt) and
  /// runs on the critical path of EVERY submission on a publicly linked route. Neither index
  /// above covers that pair — the first can only use its practitionerId prefix and must then
  /// heap-fetch and filter every row the practitioner has ever received. Intents are never
  /// deleted (§10 sweeps by status), so that cost grows monotonically forever.
  @@index([practitionerId, createdAt])
}

// Wedge 2C — webhook event log (dedup + audit + retry surface)
model WhopWebhookEvent {
  id          String    @id @default(cuid())
  whopEventId String    @unique
  eventType   String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@index([eventType, processedAt])
}

// Wedge 2A — practitioner invitation system
model Invitation {
  id               String    @id @default(cuid())
  token            String    @unique
  email            String
  invitedById      String?
  invitedBy        User?     @relation("InvitedBy", fields: [invitedById], references: [id])
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  /// Relation added so /admin/invites can reach the practitioner behind an accepted invite
  /// (for the Reset-trial action). Previously a bare String with no relation.
  acceptedByUser   User?     @relation("AcceptedBy", fields: [acceptedByUserId], references: [id])
  createdAt        DateTime  @default(now())

  @@index([email])
  @@index([acceptedAt])
}

/// Practitioner self-serve email change, gated on proving control of the NEW address before
/// `User.email` moves. Magic-link is the only sign-in path, so writing the address immediately
/// (the old `updateAccountEmail` behavior) meant a typo was a total, unrecoverable-without-admin
/// lockout. A dedicated model rather than reusing Auth.js's `VerificationToken`: that table is
/// owned by the auth adapter and keyed on `[identifier, token]` with `identifier` meaning "the
/// email a sign-in link was sent to" — repurposing it for "the NEW email of an in-progress
/// change" risks colliding with a concurrent sign-in token for that same address.
///
/// One pending request per user — enforced by `@@unique([userId])` below, not merely by app-level
/// delete-then-insert. `requestAccountEmailChange` upserts on that constraint, so a double-submit
/// or a retried POST cannot leave two live rows racing each other for the same account.
model EmailChangeRequest {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model City {
  id            String         @id @default(cuid())
  slug          String
  name          String
  state         String
  practitioners Practitioner[]

  @@unique([slug, state])
}

/// The attribution ledger: which clients we sourced for a practitioner, and until when.
///
/// Emails are stored HASHED ONLY (sha256 over a salted, lowercased address). The ledger needs
/// equality matching and nothing else, and a plaintext table of "people who saw a holistic health
/// practitioner" is the most sensitive thing this system could hold.
model AttributedClient {
  id String @id @default(cuid())

  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  /// sha256(salt:lowercased email). Never the address itself. See hashClientEmail().
  emailHash String

  /// Snapshot of WHY this client counts as ours, copied from the booking intent. Diagnostic only —
  /// the claim itself is the row's existence plus expiresAt.
  party  LeadAttributionParty?
  source String?

  /// The booking that created the claim. Nullable and never updated: a later booking extends the
  /// window but must not rewrite which one introduced them.
  firstBookingIntentId String?

  /// When we introduced them. Never moved backwards.
  attributedAt DateTime @default(now())
  /// DEPRECATED by the Lead Attribution Term (operator ruling, 2026-09-18). Kept and still
  /// written so the currently-deployed release keeps reading a column it understands
  /// (expand/contract); `termEndsAt` is the authority for every new row. Drop a release after
  /// nothing reads it.
  ///
  /// ⚠️ It also no longer MOVES. The old "a repeat booking pushes this out" behaviour was a
  /// rolling window, which is what let a single client relationship be charged a fresh
  /// first-session fee after a quiet year. The term is fixed at earliest touch — see
  /// `recordAttributedClient`.
  expiresAt    DateTime

  /// THE TERM, SNAPSHOTTED AT ROW CREATION (spec v1.4 §1.1, operator ruling 5).
  ///
  /// Snapshotting is the whole mechanism: the admin setting is editable, and without a copy taken
  /// here an operator lengthening the term would retroactively re-open claims already sold, and
  /// shortening it would cancel ones already earned. Forward-only per R1.
  ///
  /// ONE term governs BOTH plans. There is deliberately no per-plan variant.
  termMonths   Int?
  /// The anchor: the FIRST BOOKED SESSION'S SCHEDULED START — not the payment, not the click.
  /// Null until that session is known, in which case the term has not started running.
  termAnchorAt DateTime?
  /// termAnchorAt + termMonths, EXCLUSIVE. Month 8 exactly is OUTSIDE the term (spec §9 test 3).
  termEndsAt   DateTime?

  /// The practitioner who REFERRED this client to the practitioner serving them, if any.
  ///
  /// Distinct from `practitionerId` (who serves them) and from `party` (whether NHP or the
  /// practitioner sourced the visit). A referral is the third money path: it is what makes a
  /// ledger row payable to somebody who is not on either side of the booking.
  referrerPractitionerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One claim per client per practitioner — the claim is on the RELATIONSHIP, not the transaction.
  /// This pair is also the read on the critical path of every booking checkout mint.
  @@unique([practitionerId, emailHash])
  /// The leakage sweep walks live claims by hash across practitioners.
  @@index([emailHash])
  @@index([expiresAt])
  @@index([termEndsAt])
  /// "What has this practitioner referred me?" — the Clients & Referrals list (stage 4).
  @@index([referrerPractitionerId])
}


/// OPERATOR-EDITABLE COMMERCIAL SETTINGS (spec v1.4 §1.1).
///
/// A tiny key/value table rather than a column per setting: these are operator knobs whose number
/// grows, and a migration per knob is how "Lead Attribution Term" ended up as three different
/// hardcoded constants in three files. Values are STRINGS, validated and parsed on read by
/// `src/lib/platform-settings.ts`, which is also where the ruled defaults live.
model PlatformSetting {
  key   String @id
  value String

  /// Who last changed it. An answer to "who shortened the term?" that survives the person leaving.
  updatedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// What a referrer's share is doing right now.
///
/// AN ENUM, NOT A BOOLEAN — operator ruling 6, 2026-09-18. "Paid / not paid" cannot express a
/// share that is owed to somebody we currently cannot pay, and modelling it as a boolean is what
/// forces the bad fallback of collecting our own share only. Over-collecting is recoverable;
/// under-collecting is not.
enum ReferralPayableState {
  /// Owed and payable now — the referrer has a connected, payable Whop account.
  PAYABLE
  /// Owed, but the referrer cannot receive funds yet. Notified immediately; held 90 days
  /// (operator ruling 7). Settles RETROACTIVELY the moment they become payable.
  HELD
  /// The hold ran out. A TERMINAL-PENDING state that deliberately takes NO money action: nothing
  /// is forfeited to the platform, nothing is released, nothing is deleted. Surfaced in admin
  /// with its running total, settleable only by an explicit operator action.
  ///
  /// ⚠️ DO NOT ADD AN AUTOMATIC TRANSITION OUT OF THIS STATE. Day-91 policy is deliberately
  /// unruled (operator, 2026-09-18); defaulting it either way silently moves real money.
  EXPIRED_UNCLAIMED
  /// Paid out. `whopTransferId` is the receipt.
  SETTLED
}

/// One referrer's share of one payment — the referral ledger (spec v1.4 §2).
///
/// Written on `payment.succeeded`, never at mint time: the mint folds the platform take and the
/// referrer take into a SINGLE `application_fee_amount` collected on the parent, and the referrer
/// is settled afterwards by a parent → sibling transfer. This row is the record of that debt
/// between the two events, and the reconciliation surface against Whop's own fee itemisation.
model ReferralLedgerEntry {
  id String @id @default(cuid())

  /// The payment this share came out of. `whopPaymentId` is the external truth; the booking
  /// intent is how it is found from our side.
  bookingIntentId String
  bookingIntent   BookingIntent @relation(fields: [bookingIntentId], references: [id], onDelete: Cascade)
  whopPaymentId   String?

  /// Who is owed.
  referrerPractitionerId String
  referrerPractitioner   Practitioner @relation("ReferralEntriesEarned", fields: [referrerPractitionerId], references: [id], onDelete: Cascade)
  /// Whose session generated it — the practitioner who served the client.
  servingPractitionerId  String
  servingPractitioner    Practitioner @relation("ReferralEntriesGenerated", fields: [servingPractitionerId], references: [id], onDelete: Cascade)

  /// Hashed, exactly as in the attribution ledger. Never the address.
  clientEmailHash String

  /// MONEY, IN CENTS, SNAPSHOTTED. Rates change; a written row must not.
  grossUsdCents        Int
  referrerShareUsdCents Int
  /// The referrer's rate at write time, in basis points (2000 = 20%).
  referrerRateBps      Int
  /// The single application fee actually collected on the parent, for reconciliation against
  /// `GET /api/v1/payments/{id}/fees`.
  collectedFeeUsdCents Int

  state ReferralPayableState @default(PAYABLE)

  /// Set the moment the share is found unpayable and the referrer is told to claim their Whop
  /// account (operator ruling 7 — "notified immediately"). Carried on the row, from stage 1, so
  /// the notification wiring in stage 7 has somewhere idempotent to land.
  notifiedAt      DateTime?
  /// When the hold started, and when it lapses to EXPIRED_UNCLAIMED. PER ROW — a referrer with
  /// five held shares has five clocks, because each share was owed on a different day.
  holdCreatedAt   DateTime?
  holdExpiresAt   DateTime?
  /// Snapshot of the hold length this row was written under, same forward-only logic as the term.
  holdDays        Int?

  settledAt      DateTime?
  whopTransferId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// IDEMPOTENCY ON WEBHOOK RETRIES. Whop redelivers `payment.succeeded`, and a second row here is
  /// a second payout. One share per referrer per booking, enforced by the database rather than by
  /// remembering to check.
  @@unique([bookingIntentId, referrerPractitionerId])
  /// The admin hold list, and the "did anything lapse today?" sweep.
  @@index([state, holdExpiresAt])
  @@index([referrerPractitionerId, state])
}
