# HHE Directory — environment variables
# Copy to .env.local for development; provision via Vercel env for deploy.

# ----- Postgres (Neon via Vercel Marketplace integration) -----
DATABASE_URL=

# ----- NextAuth v5 -----
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ----- Upstash / Vercel KV (rate limiting; optional in Phase 0) -----
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ----- Typesense (Phase 1 search) -----
TYPESENSE_HOST=
TYPESENSE_API_KEY=
NEXT_PUBLIC_TYPESENSE_SEARCH_KEY=

# ----- Email (Resend; Phase 2 notifications) -----
RESEND_API_KEY=

# ----- Vercel Blob (Phase 3 client-held files) -----
BLOB_READ_WRITE_TOKEN=

# ----- Practitioner plans (Plan A / Plan B) -----
# RATES ARE NOT CONFIGURED HERE. Spec v1.5 §2: the database is the only source of rates — every
# price, percentage and term lives in an immutable RateSchedule row a practitioner maps to, edited
# at /admin/commercial-settings. The old PLAN_*_FEE_* / PLAN_*_MONTHLY_FEE_CENTS / XREF_* env vars
# are no longer read; setting them does nothing (tests/no-rate-literals.test.ts keeps it that way).
# Only the non-rate plan settings remain:
PLAN_A_LABEL=
PLAN_B_LABEL=
# Plan assumed for a practitioner who has not chosen one (default PLAN_B).
PLAN_DEFAULT=

# ----- Referrer payouts (spec v1.4 §6.2) — OFF, and deliberately so -----
# 🚧 The parent company is NOT business-verified, so Whop refuses every transfer from it
# ("Please verify your business before transferring funds"). Complete verification in the Whop
# dashboard FIRST, then set this to the literal string `true`. Any other value is off.
# Turning it on before verification does not break anything — the transfer simply fails and the
# ledger row stays PAYABLE — but the reason will be a Whop error rather than a clear block.
WHOP_TRANSFERS_ENABLED=
# The payee (referrer / recruiter) is meant to absorb Whop's transfer fee (src/lib/transfer-fee.ts).
# That only holds if BPS >= Whop's real rate and MODE matches Whop's real behaviour: the first real
# $1 parent -> sibling transfer, measured, is a HARD activation gate.
# MODE: 'charged-to-sender' (default; Whop bills us on top, so we send gross - fee) or
# 'deducted-from-recipient' (Whop takes it from what the payee receives; we send gross).
# BPS: default 300 (3%, measured for non-parent destinations). Re-measure after the first real $1 transfer.
WHOP_TRANSFER_FEE_MODE=
WHOP_TRANSFER_FEE_BPS=

# ----- Client attribution ledger -----
# DEPRECATED — superseded by the lead attribution term in the practitioner's RateSchedule,
# snapshotted per attribution row. Still read only to keep writing the legacy `expiresAt` column
# during expand/contract; nothing branches on it for money.
ATTRIBUTION_CLAIM_WINDOW_DAYS=
# Fallback for the operator-editable referral hold period, used only when the database has no row
# for it. The database value wins; see src/lib/platform-settings.ts. (The lead attribution term is
# no longer a setting — it lives in the rate schedule.)
REFERRAL_HOLD_DAYS=
# Permanent once set — rotating it invalidates every stored hash.
ATTRIBUTION_EMAIL_SALT=
# Example session price used only for the plan-comparison table (cents; display only, not a rate).
PLAN_COMPARISON_SESSION_PRICE_CENTS=
